# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Recommended active Groq models:
# - llama-3.3-70b-versatile (Recommended: best reasoning, 128k context, high SQL precision)
# - llama-3.1-8b-instant (Fast, lightweight alternative)
# - llama-3.1-70b-versatile (Powerful fallback)
GROQ_MODEL=llama-3.3-70b-versatile

# Application Settings
SQL_QUERY_TIMEOUT_SECONDS=10
SQL_MAX_RESULT_ROWS=5000
